{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Approved resume presentation model",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "company", "role", "sections"],
  "properties": {
    "name": { "$ref": "#/$defs/text" },
    "company": { "$ref": "#/$defs/text" },
    "role": { "$ref": "#/$defs/text" },
    "contact": { "type": "array", "items": { "$ref": "#/$defs/runs" } },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "blocks"],
        "properties": {
          "heading": { "$ref": "#/$defs/text" },
          "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper": { "enum": ["A4", "Letter"] },
        "font": { "$ref": "#/$defs/text" },
        "bodyPt": { "type": "number", "minimum": 8, "maximum": 24, "multipleOf": 0.5 },
        "headingPt": { "type": "number", "minimum": 8, "maximum": 36, "multipleOf": 0.5 },
        "marginInches": { "type": "number", "minimum": 0.5, "maximum": 1 },
        "preferredPages": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\ud800-\\udfff\\ufffe\\uffff]+$" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "$ref": "#/$defs/text" },
          "bold": { "type": "boolean" },
          "italic": { "type": "boolean" },
          "link": { "type": "string", "pattern": "^(https?://|mailto:|tel:)[^\\s]+$" }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "pageBreak" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "runs"],
          "properties": {
            "type": { "enum": ["paragraph", "bullet", "heading"] },
            "runs": { "$ref": "#/$defs/runs" },
            "keepWithNext": { "type": "boolean" },
            "pageBreakBefore": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
